export function getContractById(id: string): ContractMeta | undefined {
  return CONTRACT_REGISTRY.find((c) => c.id === id);
}

export function getContractsByCategory(category: ContractCategory): ContractMeta[] {
  return CONTRACT_REGISTRY.filter((c) => c.category === category);
}

export function getAllContractIds(): string[] {
  return CONTRACT_REGISTRY.map((c) => c.id);
}

export function getExecutionBackendEntry(backend: string) {
  const map: Record<string, { address: string; abi: unknown[] }> = {
    "stealth-exchange": {
      address: "0x788F5098C58BF5854ebf2b10B0D9303b13ABF43A",
      abi: StealthExchangeArtifact.abi,
    },
    "permit2-executor": {
      address: "0x4593D97d6E932648fb4425aC2945adaF66927773",
      abi: Permit2ExecutorABI,
    },
    "erc2612-executor": {
      address: "0xb8eF065061bbBF5dCc65083be8CC7B50121AE900",
      abi: ERC2612ExecutorABI,
    },
    "batch-multicall": {
      address: "0xF93E987DF029e95CdE59c0F5cD447e0a7002054D",
      abi: BatchMulticallABI,
    },
  };
  return map[backend] || null;
}

export function getContractRegistryEntryByName(name: string) {
  return CONTRACT_REGISTRY.find((c) => c.name === name);
}