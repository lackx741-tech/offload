import { readFileSync, writeFileSync, copyFileSync, existsSync } from "fs";
const ROOT = process.argv[2] || ".";
const p = (f) => (ROOT === "." ? f : `${ROOT}/${f}`);
let changed=0, skipped=0, failed=0;
function log(f,s,m=""){ console.log(`  ${s==="OK"?"✔":s==="SKIP"?"·":"✖"} ${f}`+(m?` — ${m}`:"")); }
function replaceFile(file,label,oldText,newText,marker){
  const path=p(file);
  if(!existsSync(path)){failed++;log(file,"FAIL","file not found");return;}
  let c=readFileSync(path,"utf8");
  if(c.includes(marker)){skipped++;log(file,"SKIP",`${label} already applied`);return;}
  if(!c.includes(oldText)){failed++;log(file,"FAIL",`${label}: anchor not found`);return;}
  if(!existsSync(path+".st3.bak"))copyFileSync(path,path+".st3.bak");
  writeFileSync(path,c.replace(oldText,newText));changed++;log(file,"OK",label);
}
function writeFile(file,label,content){
  const path=p(file);
  if(!existsSync(path)){failed++;log(file,"FAIL","file not found");return;}
  if(readFileSync(path,"utf8").includes(label)){skipped++;log(file,"SKIP",`${label} already applied`);return;}
  if(!existsSync(path+".st3.bak"))copyFileSync(path,path+".st3.bak");
  writeFileSync(path,content);changed++;log(file,"OK",label);
}
console.log(`Patching ${ROOT}\n`);

