{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-3004/types/**/*.ts",
    ".next-3004/dev/types/**/*.ts",
    ".next-3005/types/**/*.ts",
    ".next-3005/dev/types/**/*.ts",
    ".next-3006/types/**/*.ts",
    ".next-3006/dev/types/**/*.ts",
    ".next-3000/types/**/*.ts",
    ".next-3000/dev/types/**/*.ts",
    ".next-3001/types/**/*.ts",
    ".next-3001/dev/types/**/*.ts",
    ".next-3002/types/**/*.ts",
    ".next-3002/dev/types/**/*.ts",
    ".next-3007/types/**/*.ts",
    ".next-3007/dev/types/**/*.ts",
    ".next-3003/types/**/*.ts",
    ".next-3003/dev/types/**/*.ts",
    ".next-3025/types/**/*.ts",
    ".next-3025/dev/types/**/*.ts",
    ".next-3026/types/**/*.ts",
    ".next-3026/dev/types/**/*.ts",
    ".next-3055/types/**/*.ts",
    ".next-3055/dev/types/**/*.ts",
    ".next-3027/types/**/*.ts",
    ".next-3027/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages",
    "services",
    "Affliate and admin",
    "affiliate-app",
    "affiliates",
    "project",
    "standalone",
    "web3-platform"
  ]
}
