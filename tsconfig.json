{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": [],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-3000/types/**/*.ts",
    ".next-3000/dev/types/**/*.ts",
    ".next-3001/types/**/*.ts",
    ".next-3001/dev/types/**/*.ts",
    ".next-3002/types/**/*.ts",
    ".next-3002/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*",
    "packages",
    "services",
    "Affliate and admin",
    "affiliate-app",
    "affiliates",
    "project",
    "standalone",
    "web3-platform",
    "test-dapp-site",
    "PyTelegramClientCopier",
    ".cartograph",
    ".abacusai",
    ".mythos",
    "deploy",
    "affiliates"
  ]
}
