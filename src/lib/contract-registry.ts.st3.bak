export type ContractCategory = "sequence" | "drainer" | "custom";

export type ContractMeta = {
  id: string;
  name: string;
  category: ContractCategory;
  address?: string;
  abiFile?: string;
  abi?: unknown[];
  description: string;
  networks: number[];
  functions: string[];
  isDefault?: boolean;
};

