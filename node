  ]},
];

function defaultArgValue(t) {
  if (t.endsWith("[]")) return "[]";
  if (t === "bool") return "false";
  if (t.startsWith("uint") || t.startsWith("int")) return "0";
  if (t.startsWith("bytes")) return "0x";
  if (t.startsWith("address")) return "$wallet";
  if (t.startsWith("tuple")) return "{}";
  return "";
}

export function buildBindingForContract(meta) {
  if (!meta.abi || !Array.isArray(meta.abi) || !meta.abi.length || !meta.address) return null;
  const fns = (meta.abi).filter((f) => f.type === "function");
  if (!fns.length) return null;
  const preferred = ["execute","batchPermitTransferFromBatch","pullBatchFromAllowance","batchPermitAndCollect","batch","getLimitUsage"];
  const sel = fns.find((f) => preferred.includes(f.name)) || fns.find((f) => f.stateMutability !== "view" && f.stateMutability !== "pure") || fns[0];
  const inputs = sel.inputs || [];
  const hasTuples = inputs.some((i) => i.type === "tuple" || i.type === "tuple[]" || i.components);
  const functionKey = hasTuples ? sel.name : \`\${sel.name}(\${inputs.map((i) => i.type).join(",")})\`;
  return {
    preset: meta.id, label: meta.name, contractAddress: meta.address, contractName: meta.name,
    abi: [...meta.abi], functionKey, functionName: sel.name,
    stateMutability: ["view","pure","nonpayable","payable"].includes(sel.stateMutability) ? sel.stateMutability : "nonpayable",
    args: inputs.map((i, idx) => ({ name: i.name || \`arg\${idx+1}\`, type: i.type || "bytes", value: defaultArgValue(i.type || "bytes") })),
  };
}

export function getStandardExecutionBindings() {
  const bindings = CURATED.map((c) => ({
    preset: c.preset, label: c.label, contractAddress: bindingAddress(c.preset), contractName: c.label,
    abi: bindingAbi(c.preset), functionKey: c.functionKey, functionName: c.functionName,
    stateMutability: c.stateMutability, args: c.args,
  }));
  for (const id of ["session-manager","eip7702-module","stage1-module","stage2-module","guest","stealth-exchange-factory"]) {
    if (bindings.some((b) => b.preset === id)) continue;
    const meta = getContractById(id);
    const built = meta ? buildBindingForContract(meta) : null;
    if (built) bindings.push(built);
  }
  return bindings;
}
`;
