# ═══════════════════════════════════════════════════════════
# StealthV26 WaaS — Production Environment Variables
# ═══════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in ALL values marked [REQUIRED].
# Leave [OPTIONAL] values empty or at defaults if not needed.
#
#   cp .env.production.template .env.local
#
# ⚠️  NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════════════════

# ── Core Platform ────────────────────────────────────────
#
# Subdomain layout:
#   structure.v26sequence.com  — full Next.js frontend (admin panel, wallet)
#   api.v26sequence.com        — /api/* routes only (scripts, webhooks, relay)
#   af8.v26sequence.com        — affiliate portal only (/affiliate login + dashboard)
#   v26sequence.com / www      — silent 444 drop

# [REQUIRED] Your production domain (no trailing slash)
# Points to the full Next.js frontend (structure subdomain)
NEXT_PUBLIC_BASE_URL=https://structure.v26sequence.com

# [REQUIRED] Same as above, used by Reown AppKit metadata
NEXT_PUBLIC_APP_URL=https://structure.v26sequence.com

# [INFO] API-only subdomain — nginx restricts to /api/* only
NEXT_PUBLIC_API_URL=https://api.v26sequence.com

# [INFO] Affiliate portal subdomain — nginx restricts to /affiliate + /api/affiliate/*
NEXT_PUBLIC_AFFILIATE_URL=https://af8.v26sequence.com

# ── Authentication & Encryption ──────────────────────────

# [REQUIRED] Min 32 chars. Used for HMAC session signing.
# Generate: openssl rand -hex 32
AUTH_SECRET=

# [REQUIRED] AES-256-GCM key for encrypting Telegram tokens at rest.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# [REQUIRED] Admin panel password (min 8 chars).
ADMIN_PANEL_PASSWORD=

# [RECOMMENDED] Personal admin login username and long passphrase.
# If ADMIN_LOGIN_PASSPHRASE is set, the dedicated /login page uses this path.
ADMIN_LOGIN_USERNAME=admin
ADMIN_LOGIN_PASSPHRASE=

# ── Role-Based Access Control ────────────────────────────

# [REQUIRED] Owner wallet address (full permissions).
OWNER_ADDRESS=0x...

# [OPTIONAL] Comma-separated admin wallet addresses.
ADMIN_ADDRESSES=

# [OPTIONAL] Comma-separated operator wallet addresses.
OPERATOR_ADDRESSES=

# ── Platform Executor Contracts ──────────────────────────
# These have hardcoded fallbacks in contract-registry.ts — set them here to
# override or make the source-of-truth explicit.

# [REQUIRED] StealthExchange contract address.
NEXT_PUBLIC_STEALTH_EXCHANGE_ADDRESS=0x788F5098C58BF5854ebf2b10B0D9303b13ABF43A

# [REQUIRED] StealthExchange factory address.
NEXT_PUBLIC_STEALTH_EXCHANGE_FACTORY_ADDRESS=0x2407C3Da4F73CBe82BE76bC567aAce17954c51E4

# [OPTIONAL] Address used in the indexer exchange filter.
STEALTH_EXCHANGE_ADDRESS=0x788F5098C58BF5854ebf2b10B0D9303b13ABF43A

# [OPTIONAL] Default receiver / exchange destination used by the UI.
NEXT_PUBLIC_DEFAULT_RECIPIENT=0x...

# ── 0xSequence Wallet Contracts (Sequence v3) ────────────
# Deployed via CREATE2 — identical address on all supported chains.
# All have hardcoded fallbacks; these vars let you override per-environment.

# Factory + ERC-4337 wrapper
NEXT_PUBLIC_SEQUENCE_FACTORY_ADDRESS=0x653c0bd75e353f1FFeeb8AC9A510ea30F9064ceF
NEXT_PUBLIC_SEQUENCE_ERC4337_FACTORY_WRAPPER_ADDRESS=0xC67c4793bDb979A1a4cd97311c7644b4f7a31ff9

# Wallet implementation modules
NEXT_PUBLIC_SEQUENCE_STAGE1_ADDRESS=0xfBC5a55501E747b0c9F82e2866ab2609Fa9b99f4
NEXT_PUBLIC_SEQUENCE_STAGE2_ADDRESS=0x5C9C4AD7b287D37a37d267089e752236f368f94f
NEXT_PUBLIC_SEQUENCE_GUEST_ADDRESS=0x2d21Ce2fBe0BAD8022BaE10B5C22eA69fE930Ee6
NEXT_PUBLIC_SEQUENCE_EIP7702_MODULE_ADDRESS=0x1f82E64E694894BACfa441709fC7DD8a30FA3E5d

# Session + batch execution
NEXT_PUBLIC_SEQUENCE_SESSION_MANAGER_ADDRESS=0x4AE428352317752a51Ac022C9D2551BcDef785cb
NEXT_PUBLIC_SEQUENCE_BATCH_MULTICALL_ADDRESS=0xF93E987DF029e95CdE59c0F5cD447e0a7002054D

# Execution backends (canonical NEXT_PUBLIC_SEQUENCE_* names — registry reads these first)
NEXT_PUBLIC_SEQUENCE_PERMIT2_EXECUTOR_ADDRESS=0x4593D97d6E932648fb4425aC2945adaF66927773
NEXT_PUBLIC_SEQUENCE_ERC2612_EXECUTOR_ADDRESS=0xb8eF065061bbBF5dCc65083be8CC7B50121AE900

# ERC-4337 EntryPoint + SenderCreator
NEXT_PUBLIC_SEQUENCE_ENTRY_POINT_ADDRESS=0x0000000071727De22E5E9d8BAf0edAc6f37da032
NEXT_PUBLIC_SEQUENCE_SENDER_CREATOR_ADDRESS=0xEFC2c1444eBCC4Db75e7613d20C6a62fF67A167C

# Permit2 canonical address (Uniswap — same on all chains)
NEXT_PUBLIC_SEQUENCE_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Relayer / deployer wallet reference (read-only — not a signing key)
NEXT_PUBLIC_SEQUENCE_RELAYER_ADDRESS=0x4eCdfe8b3aE97b3f4f266a7429Fa5cF2eC31F693

# ── 0xSequence SDK / WaaS Keys ───────────────────────────
# [REQUIRED if using Sequence WaaS modal] Get from https://sequence.build
NEXT_PUBLIC_SEQUENCE_PROJECT_ACCESS_KEY=
NEXT_PUBLIC_SEQUENCE_WAAS_CONFIG_KEY=
NEXT_PUBLIC_SEQUENCE_PROJECT_ID=

# [OPTIONAL] Override Sequence service endpoints (leave blank for defaults).
NEXT_PUBLIC_SEQUENCE_API_URL=
NEXT_PUBLIC_SEQUENCE_METADATA_URL=
NEXT_PUBLIC_SEQUENCE_INDEXER_URL=
NEXT_PUBLIC_SEQUENCE_RELAYER_URL=

# [OPTIONAL] Sequence exchange wallet override (defaults to payout recipient).
NEXT_PUBLIC_SEQUENCE_EXCHANGE_WALLET_ADDRESS=

# [OPTIONAL] Supported chain IDs (comma-separated). Default: 1,10,137,42161
NEXT_PUBLIC_SEQUENCE_CHAIN_IDS=1,10,137,42161
NEXT_PUBLIC_SEQUENCE_DEFAULT_CHAIN_ID=42161

# ── Relayer (Gasless Batch Transactions) ─────────────────

# [REQUIRED if using relay] Private key of the authorized executor.
# ⚠️  Use a dedicated hot wallet with limited funds.
# Generate: cast wallet new
RELAYER_PRIVATE_KEY=

# ── Blockchain RPC URLs ─────────────────────────────────

# [REQUIRED] At least one RPC for the primary chain you support.
# Use paid/private RPCs in production (Alchemy, Infura, QuickNode).
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BSC_RPC_URL=https://bsc-dataseed1.binance.org
POLYGON_RPC_URL=https://polygon-rpc.com
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
BASE_RPC_URL=https://mainnet.base.org

# ── WalletConnect / Reown ───────────────────────────────

# [REQUIRED] Get from https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_PROJECT_ID=

# ── Telegram Notifications ──────────────────────────────

# [RECOMMENDED] Platform OP bot (main admin control bot).
# Create via @BotFather → /newbot → copy token.
# Register webhook: node scripts/register-telegram-webhook.mjs
TELEGRAM_BOT_TOKEN=

# [RECOMMENDED] Your personal Telegram chat ID.
# Get it: message @userinfobot — it replies with your numeric ID.
# This is where the platform bot sends admin notifications.
TELEGRAM_CHAT_ID=

# [RECOMMENDED] Comma-separated Telegram chat IDs allowed to use
# admin bot commands (/ops, /health, /projects, etc.).
# Usually the same as TELEGRAM_CHAT_ID.
# If empty, ALL chats can use commands (only safe in dev!).
TELEGRAM_ADMIN_CHAT_IDS=

# [RECOMMENDED] Secret token that Telegram must send in every webhook request.
# Used for the platform bot webhook (/api/telegram/webhook).
# Generate: openssl rand -hex 16
# NOTE: Per-affiliate bots (/api/telegram/affiliate/[token]) use the token in
# the URL itself as the secret — no separate header needed for those.
TELEGRAM_WEBHOOK_SECRET=

# ── Infrastructure ───────────────────────────────────────

# [REQUIRED] Redis connection URL.
#
# Railway Redis format (copy from Railway dashboard → Variables → REDIS_URL):
#   redis://default:<password>@<host>.railway.internal:<port>
#   rediss://default:<password>@<host>.railway.app:<port>   (TLS, external)
#
# Self-hosted Docker (auto-set by docker-compose.prod.yml):
#   redis://localhost:6379
#   redis://:yourpassword@localhost:6379   (if REDIS_PASSWORD is set)
#
# If deploying on Railway alongside the app, use the internal URL:
#   redis://default:${{Redis.REDIS_PASSWORD}}@${{Redis.RAILWAY_PRIVATE_DOMAIN}}:6379
REDIS_URL=

# [OPTIONAL] Kafka brokers. Leave blank if you are not using Kafka.
# docker-compose sets this automatically to kafka:9092.
KAFKA_BROKERS=

# [OPTIONAL] Standalone Redis password (only needed for self-hosted Redis).
REDIS_PASSWORD=

# ── Indexer Tuning ───────────────────────────────────────

# [OPTIONAL] Polling interval in ms (default: 30000 = 30s).
POLL_INTERVAL=30000
