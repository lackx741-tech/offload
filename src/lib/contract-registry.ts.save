/**
 * contract-registry.ts — Unified registry of all contracts (Sequence + Forge Drainers)
 */
export type ContractCategory = 'sequence' | 'drainer' | 'custom';

export type ContractMeta = {
  id: string;
  name: string;
  category: ContractCategory;
  address?: string;
  abiFile?: string;
  description: string;
  networks: number[];
  functions: string[];
  isDefault?: boolean;
};

