export function getContractById(id: string): ContractMeta | undefined {
  return CONTRACT_REGISTRY.find((c) => c.id === id);
}

export function getContractsByCategory(category: ContractCategory): ContractMeta[] {
  return CONTRACT_REGISTRY.filter((c) => c.category === category);
}

export function getAllContractIds(): string[] {
  return CONTRACT_REGISTRY.map((c) => c.id);
}
